-// This is the regular CRC16 (0x8005 poly) but in reverse (0xA001)
-uint16_t ds_crc16(const uint8_t *buf, unsigned size) {
-  uint16_t ret = 0xFFFF;
-  for (unsigned i = 0; i < size; i++) {
-    ret ^= *buf++;
-    for (unsigned j = 0; j < 8; j++)
-      ret = (ret >> 1) ^ ((ret & 1) ? 0xA001 : 0);
-  }
-  return ret;
-}
